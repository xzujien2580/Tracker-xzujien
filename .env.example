PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=./data/etairos.sqlite

# The first verified registration for this Gmail address becomes the initial ADMIN.
BOOTSTRAP_ADMIN_EMAIL=

# Gmail SMTP (use a Google app password, never your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ETAIROS Tracker <your-address@gmail.com>

# Google Identity Services and Drive read-only access
GOOGLE_CLIENT_ID=

# Optional CORS allow-list, comma-separated
CORS_ORIGINS=
